# ═══════════════════════════════════════════════════════════════════════════════
# RADIX Platform — Master Environment File
# Copy to .env in the radix-platform/ root and fill in secrets.
# Individual services read this via the setup script OR their own .env.
# NEVER commit a file with real keys.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Ports (change only if something clashes) ────────────────────────────────
ROLE1_PORT=8001
ROLE2_PORT=8002
ROLE3_PORT=8003
ROLE4_PORT=8004
ROLE5_PORT=8005
FRONTEND_PORT=8080

# ── Role 1: JD Analytics (Gemini + ChromaDB) ────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=gemini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1.0
MAX_UPLOAD_SIZE_MB=10
MAX_EXTRACTED_TEXT_CHARS=60000
MAX_PDF_PAGES=200
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=jd_chunks
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
JD_DATABASE_PATH=./data/jd_analyses.sqlite3
STORAGE_BACKEND=sqlite

# ── Role 2: Resume Parsing (Groq LLM) ───────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# ── Role 3: Profile Builder (Supabase or in-memory) ─────────────────────────
# Leave SUPABASE_URL blank to run in local in-memory mode (no data persists after restart)
SUPABASE_URL=
SUPABASE_KEY=
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Role 4: Talent Check (no external API needed) ───────────────────────────
# Optional GitHub token for web-level-scrapping sub-tool (not required for API)
GITHUB_TOKEN=

# ── Role 5: Skill Matching (fully deterministic, no API key needed) ──────────
SKILL_MATCH_HOST=0.0.0.0
SKILL_MATCH_PORT=8005
# Optional OpenAI-compatible LLM for richer improvement plans (off by default)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=20

# ── Shared CORS (all services allow the frontend origin) ────────────────────
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080
