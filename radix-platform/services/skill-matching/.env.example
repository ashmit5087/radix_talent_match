# Optional. The baseline needs no configuration and no API keys.
SKILL_MATCH_HOST=127.0.0.1
SKILL_MATCH_PORT=8005

# Optional LLM improvement-plan layer (off unless requested AND configured).
# Any OpenAI-compatible provider works; the offline deterministic plan remains
# the source of truth for scores, gains, ordering, and action selection.
# Groq example:       LLM_BASE_URL=https://api.groq.com/openai/v1
# OpenRouter example: LLM_BASE_URL=https://openrouter.ai/api/v1
# Local Ollama:       LLM_BASE_URL=http://localhost:11434/v1  (LLM_API_KEY=ollama)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=20
