# Environment Configuration for Role 3: Profile Builder
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Supabase Credentials (leave blank to run in local in-memory persistence mode for tests/offline development)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# CORS Settings (comma-separated list of origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
