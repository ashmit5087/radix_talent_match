# RADIX Platform — Frontend environment variables
# Copy this to .env and fill in the values before starting the dev server.
# All VITE_* vars are injected at build time by Vite.

# ─── Role 1: JD Analytics (FastAPI, port 8001) ──────────────────────────────
VITE_JD_API_URL=http://localhost:8001

# ─── Role 2: Resume Parsing (FastAPI adapter, port 8002) ────────────────────
VITE_RESUME_API_URL=http://localhost:8002

# ─── Role 3: Profile Builder (FastAPI, port 8003) ───────────────────────────
VITE_PROFILE_API_URL=http://localhost:8003

# ─── Role 4: Talent Check (FastAPI, port 8004) ──────────────────────────────
VITE_TALENT_API_URL=http://localhost:8004

# ─── Role 5: Skill Matching (FastAPI, port 8005) ────────────────────────────
VITE_MATCH_API_URL=http://localhost:8005

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
